# Synthetic i3/Sway configuration used to exercise the parser end to end.

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term example-terminal
set $term_app_id ExampleTerminal
set $launcher example-launcher

font pango:Monospace 10
default_border pixel 3
floating_modifier $mod normal

output * scale 1

input type:touchpad {
    tap enabled
    natural_scroll enabled
}

bar {
    position bottom
    status_command example-status
}

client.focused #cccccc #333333 #ffffff #336699 #cccccc

set $outer_gap "0"
set $inner_gap "30"
gaps outer $outer_gap
gaps inner $inner_gap

for_window [app_id=$term_app_id] opacity 0.9

bindsym $mod+return exec $term
bindsym $mod+q exec $launcher
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+shift+$left move left
bindsym $mod+shift+$down move down
bindsym $mod+shift+$up move up
bindsym $mod+shift+$right move right

bindsym $mod+Alt+$left resize shrink width 350px
bindsym $mod+alt+$down resize grow height 350px
bindsym $mod+alt+$up resize shrink height 350px
bindsym $mod+alt+$right resize grow width 350px

bindsym $mod+1 workspace number 1
bindsym $mod+shift+1 move container to workspace number 1

bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+w layout toggle split
bindsym $mod+e layout tabbed
bindsym $mod+r layout stacking
bindsym $mod+f fullscreen
bindsym $mod+ctrl+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

bindsym $mod+shift+minus move scratchpad
bindsym $mod+minus scratchpad show
